dplyr::select(Variable, Intercept_smoothed_bspline, Beta_smoothed_bspline) |>
dplyr::rename(Intercept = Intercept_smoothed_bspline, Beta = Beta_smoothed_bspline)
# write_rds(results.lr.smoothed.bspline,
