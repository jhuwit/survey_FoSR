"Beta",
"Intercept",
"Beta_smoothed",
"Intercept_smoothed",
"Beta_smoothed_bspline",
"Intercept_smoothed_bspline"
)
plot_pw_effects(results.lr,
facet_labels = facet_labels,
type_vars = type_vars)
